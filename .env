# A local Ubuntu 22.04 base image, imported from the official ubuntu-base
# rootfs. This avoids Docker Hub/MCR entirely on networks where registry pulls
# are blocked or a broken system proxy is configured.
#
# Recreate it with:  bash scripts/import-base-image.sh
# Alternatively use BASE_IMAGE=ubuntu:22.04 if Docker Hub works for you.
BASE_IMAGE=dds-lab-base:22.04

# Ubuntu apt mirror used while building the image.
UBUNTU_MIRROR=mirrors.ustc.edu.cn
